# Copy to .env and fill in. .env is gitignored -- never commit a real key.
# Create a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Only needed when a deployed frontend calls this API from another domain.
# localhost:5173 is always allowed, so local development does not need this.
# FRONTEND_URL=https://your-frontend.up.railway.app
